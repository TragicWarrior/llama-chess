###############################################################################
# This is an example configuration file for CBoard. All of the settings below
# are the program defaults. Empty lines and lines beginning with '#' are
# ignored. Parameters and values are separated by one or more space or TAB
# characters and must be on the same line. Options which are noted to have a
# BOOL value can be one of: true, 1, yes, on OR false, 0, no, off.
###############################################################################
# Set the Black tag to the chess engine command used during human/engine
# play.
#engine_cmd_blacktag on

# The command of the chess engine to use. Engines that support the xboard
# protocol should work.
#engine_cmd	gnuchess --xboard

# The version of the XBoard protocol the engine uses. Version 2 of the
# protocol supports SAN formatted moves. Version 1 does not.
#engine_protocol	1

# Send a command to the chess engine each time a new game is started or reset.
# Can be used more than once to specify as many commands as needed.
#engine_init	depth 3

# Send the "go" command to the chess engine during the first move.
# This fixes a quirk when interfacing with polyglot(1). 
#fm_polyglot off

# The number of moves to jump when browsing move history and pressing the UP
# or DOWN keys.
#jump_count	5

# If set, the default directory where games will be saved to and opened from.
# A tilde '~' will be expanded to your home directory.
#save_directory	/some/path

# When saving a game, prompt to edit PGN data. When saving in history mode,
# prompt for the history type. If off, you can override it using the ingame 'S'
# command. BOOL
#save_prompt	on

# When deleting games with the 'X' command and this is on, prompt before
# deleting. BOOL
#delete_prompt	on

# If enabled, chess board line graphics will be drawn. BOOL
#line_graphics	on

# If on, show valid moves for the selected piece. BOOL
#valid_moves	on

# When enabled castling availability and the en passasnt square will be shown
# on the board. This can be toggled with the `^d' key. BOOL
#board_details	on

# When board_details is enabled, change an attacking piece to
# color_board_attack.
#show_attacks on

# If enabled and there is a parsing error when loading a file, stop processing
# immediately. Normally a game or round will be flagged as having an error and
# other games will be loaded. BOOL
#stop_on_error	off

# The number of full moves to write per linea (up to 80 columns) when saving a
# game. If 0, then try and fit as many as possible in 80 columns.
#mpl		0

# When enabled a castling move will be invalid if the opponent can attack a
# castling square, beit the King, Rook or the squares between the two.
#strict_castling	off

# Custom roster tags to add to new games and existing games with the -t
# switch. If an existing tag with the same name exists then the tag will be
# updated with the new value. You can add as many tags as needed.
#tag		White	Ben Kibbey

# When browsing files in the file browser filter files in the current
# directory according to the specified glob(7) pattern. If
# save_directory is defined then the pattern will be appended to that
# value. Directories (including hidden) are always displayed
# reguardless of the pattern.
#pattern		*.[Pp][Gg][Nn]*

# Confirm before quitting.
#exit_dialog_box on

# Change the layout of the screen to have the chess board on the left
# side rather than the right.
#board_left on

# Whether to show the board ranks on the left or right side of the chess
# board.
#coords_y_left yes

# Whether to enable UTF-8 board pieces.
#utf8_pieces off

# Below are color and attribute settings. These parameters may contain up to
# four values. The first and second are the foreground and background color
# names which must be one of: black, white, red, magenta, yellow, blue, cyan,
# green or - for the default color. Not all parameters actually use both the
# fore and background colors (i.e., with color_board_white, the foreground
# color is used as the color piece while the background color is used as the
# background for the white square), they may be mixed with other color
# settings when needed especially when drawing the board.
#
# Each ..._window parameter sets the defaults for all characters in the
# associated window.
#
# The third and fourth values are attributes for the color and non-color
# terminal. To include more than one attribute for a value, separate them with
# a single comma. The following attributes are available: bold, blink,
# reverse, dim, standout, underline, invisible, none or - for the default
# attribute. Note that not all terminals support all attributes.
#color_board_window		white	black
#color_board_graphics		white	black
#color_board_selected		white	yellow	none	bold,reverse
#color_board_cursor		white	green	none	bold,reverse
#color_board_black		cyan	black
#color_board_white		white	red	none	reverse
#color_board_coords		yellow	black	bold
#color_board_count		magenta	cyan	bold	bold,reverse
#color_board_white_moves	white	magenta	none	reverse
#color_board_black_moves	white	blue	none	reverse
#color_board_castling		yellow	black	bold	bold
#color_board_enpassant		magenta black	bold	bold
#color_board_attack             blue    black   bold    reverse
#color_board_prev_move		white	magenta	none	bold,reverse
#
#color_status_window	white	black
#color_status_title	white	blue	none	reverse
#color_status_border	cyan	black
#color_status_notify	green	black	none	bold
#color_status_engine	yellow	black	none	bold
#
#color_tag_window	white	black
#color_tag_title	white	blue	none	reverse
#color_tag_border	cyan	black
#
#color_history_window	white	black
#color_history_title	white	blue	none	reverse
#color_history_border	cyan	black
#
#color_message_window	white	black
#color_message_title	white	magenta	none	reverse
#color_message_border	cyan	black
#color_message_prompt	white	magenta	none	bold
#
#color_input_window	white	black
#color_input_title	white	magenta	none	reverse
#color_input_border	cyan	black
#color_input_prompt	white	magenta	none	bold
#
#color_menu		white	black	none	none
#color_menu_selected	white	red	none	bold
#color_menu_highlight	blue	yellow	none	bold
#color_menu_graphics	green	black	bold	bold

# Sends a command to the chess engine when the specified key is pressed. The
# bound key will only be available in play mode and will only get sent if it
# doesn't conflict with other play mode keys. The first argument describes how
# the key behaves when a repeat count is used (typing a series of numbers
# before pressing the key). A type of 'set' will append the repeat count to
# the command, 'repeat' will send the command the amount of times specified by
# the repeat count and 'none' will send the command only once, unaltered.
#
# Typing '23D' in play mode will send "depth 23" to the engine.
#cbind	set	D	depth
#
# Typing '23$' in play mode will send "something" to the engine 23 times.
#cbind	repeat	$	something
#
# Only send "depth 1" to the engine.
#cbind	none	!	depth 1

# These are the default key bindings. Control keys can be specified be
# prefixing the key with a '^' and function keys with a 'F' followed by the
# function key number. If a key is already bound then the existing key will be
# updated. This may result in the same key being bound to more than one
# function. If that's the case, only one of the commands will be executed.

# Play mode keys.
#    Mode       Key             Command
#bind play	"<space>"	select
#bind play	"<enter>"	commit
#bind play	"<escape>"	cancel_selected
#bind play	"C"		set_clock
#bind play	"w"		toggle_play_eh
#bind play	"u"		undo
#bind play	"g"		go
#bind play	"|"		send_command
#bind play	"E"		toggle_engine
#bind play	"H"		toggle_human
#bind play	"<F1>"		help
#bind play	"p"		toggle_pause
#bind play	"h"		history_mode
#bind play	"e"		edit_mode
#
# History mode keys.
#    Mode       Key             Command
#bind history	"<up>"		jump_next
#bind history	"<down>"	jump_prev
#bind history	"<right>"	next
#bind history	"<left>"	prev
#bind history	"<space>"	half_move_toggle
#bind history	"j"		jump
#bind history	"/"		find_new
#bind history	"]"		find_next
#bind history	"["		find_prev
#bind history	"<^a>"		annotate
#bind history	"+"		rav_next
#bind history	"-"		rav_prev
#bind history	"M"		menu
#bind history	"h"		toggle
#bind history	"<f1>"		help
#bind_history   "r"             rotate_board

# Board editing keys.
#    Mode       Key             Command
#bind edit	"<space>"	select
#bind edit	"<enter>"	commit
#bind edit	"<escape>"	cancel_selected
#bind edit	"d"		delete
#bind edit	"i"		insert
#bind edit	"c"		toggle_castle
#bind edit	"p"		enpassant
#bind edit	"w"		switch_turn
#bind edit	"<f1>"		help
#bind edit	"e"		exit

# Macros should be defined AFTER all key bindings. The bound key "presses" a
# series of keys in the specified game mode. The "any" game mode can be used
# to access the global keys. Macros may contain other macros too.

# This would edit the "White" roster tag when pressing CTRL-v.
#	Mode	Key		Key sequence
#macro 	any	"<^v>"		"<^t><^a>white<enter><^u>edited with a macro<enter><^x>"
