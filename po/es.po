#: src/tags.c:480
msgid "Tag Editing Keys"
msgstr "Teclas de Editor de Etiquetas"

#: src/tags.c:481
msgid ""
"    UP/DOWN - previous/next menu item\n"
"   HOME/END - first/last menu item\n"
"  PGDN/PGUP - next/previous page\n"
"  a-zA-Z0-9 - jump to item\n"
"      ENTER - edit select item\n"
"     CTRL-a - add an entry\n"
"     CTRL-f - add FEN tag from current position\n"
"     CTRL-r - remove selected entry\n"
"     CTRL-t - add custom tags\n"
"     CTRL-x - quit with changes\n"
"     ESCAPE - quit without changes"
msgstr ""
" ARRIBA/ABAJO - elemento de menu previo/siguiente\n"
"   INICIO/FIN - elemento de menu primero/ultimo\n"
"RE PÁG/AV PÁG - pagina siguiente/previa\n"
"    a-zA-Z0-9 - saltar a elemento\n"
"        INTRO - editar elemento selecionado\n"
"       CTRL-a - añadir una entrada\n"
"       CTRL-f - añadir etiqueta FEN desde posición actual\n"
"       CTRL-r - remover entrada seleccionada\n"
"       CTRL-t - añadir etiquetas personalizadas\n"
"       CTRL-x - salir con cambios\n"
"       ESCAPE - salir sin cambios"

